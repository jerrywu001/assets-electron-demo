{
  "name": "asset-inventory-client",
  "version": "1.0.0",
  "description": "资产台账管理系统（Electron + Vue3 + TypeScript）：组织架构 / 员工 / 资产登记 / 台账 / 设备总览 / 折旧净值 / 采集联动 / Excel 导出 / 安全管控",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "smoke": "electron-vite build && electron . --smoke",
    "ipc-test": "electron-vite build && electron . --ipc-test",
    "seed:rich": "node scripts/seed-rich.mjs",
    "dist": "electron-vite build && electron-builder",
    "clean": "node scripts/clear-data.js"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "element-plus": "^2.14.4",
    "exceljs": "^4.4.0",
    "mysql2": "^3.23.3",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.example.assetinventory",
    "productName": "资产台账管理系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://intranet.example.com/asset-client/",
        "channel": "latest"
      }
    ]
  },
  "author": "jerrywu001"
}
