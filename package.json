{
  "name": "asset-inventory-client",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "资产台账管理系统（Electron + Vue3 + TypeScript）：组织架构 / 员工 / 资产登记 / 台账 / 设备总览 / 折旧净值 / 采集联动 / Excel 导出 / 安全管控",
  "main": "out/main/index.js",
  "scripts": {
    "preinstall": "only-allow pnpm",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "smoke": "electron-vite build && electron . --smoke",
    "ipc-test": "electron-vite build && electron . --ipc-test",
    "seed:rich": "node scripts/seed-rich.mjs",
    "dist": "electron-vite build && electron-builder",
    "clean": "node scripts/clear-data.js",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"scripts/**/*.{js,mjs}\"",
    "stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run stylelint",
    "prepare": "husky"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "element-plus": "^2.14.4",
    "exceljs": "^4.4.0",
    "mysql2": "^3.23.3",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "only-allow": "1.2.1",
    "stylelint": "~16.26.1",
    "stylelint-config-recommended-vue": "~1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "build": {
    "appId": "com.example.assetinventory",
    "productName": "资产台账管理系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://intranet.example.com/asset-client/",
        "channel": "latest"
      }
    ]
  },
  "author": "jerrywu001"
}
